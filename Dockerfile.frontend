# ── Stage 1: install dependencies ─────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# ── Stage 2: build Next.js app ─────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# NEXT_PUBLIC_* vars are inlined at build time by Next.js.
# Override at build time via docker-compose build args if the backend is on a
# different host port.
ARG NEXT_PUBLIC_API_URL=http://localhost:3001/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN npm run build

# ── Stage 3: production runner (standalone output) ─────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Non-root user for security
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

# Copy the standalone server bundle produced by `output: "standalone"`
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./

# Copy static assets – must sit alongside server.js so Next.js serves them
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Copy public assets if the directory exists (currently empty in this project)
RUN mkdir -p ./public

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# API_URL is read at runtime by SSR server components to reach the backend
# container via the internal Docker network.
# Set this env var in docker-compose (e.g. API_URL=http://backend:3001/api).

CMD ["node", "server.js"]
